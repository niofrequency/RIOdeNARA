rules_version = '2';

// RiO de NARA — Firestore security rules
// =========================================
// Paste this entire file into: Firebase Console → Firestore Database →
// Rules tab → Publish. See SETUP.md for the full walkthrough.
//
// What this does:
//   - Anyone visiting the site can READ the menu (so Order Online works
//     for every customer, logged in or not).
//   - Anyone can CREATE an order or a reservation (so customers can
//     submit without needing an account).
//   - Only a signed-in admin (you, logged into /admin) can READ, EDIT
//     or DELETE orders/reservations, or ADD/EDIT/DELETE menu items.
//   - Nobody but a signed-in admin can do anything else.

service cloud.firestore {
  match /databases/{database}/documents {

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
